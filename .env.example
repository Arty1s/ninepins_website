NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Set this when you want Next.js /api/* calls to be served by FastAPI.
FASTAPI_URL=http://127.0.0.1:8000

# Supabase Auth - required for member email login and Google/Facebook login
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for backend writes to Supabase. Keep this secret, never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local admin login
ADMIN_EMAIL=admin@kkhlohovec.sk
ADMIN_SESSION_SECRET=change-this-long-random-string

# Optional: set true only on HTTPS production
ADMIN_COOKIE_SECURE=false

# User/member sessions
USER_SESSION_SECRET=change-this-long-random-string-too

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Daily kolky.sk import. In production call /api/import/kolky?secret=... every 24h.
KOLKY_IMPORT_SECRET=
KOLKY_IMPORT_URLS=https://vysledky.kolky.sk/match/detail/43531/KO-Zarnovica-vs-KKZ-Hlohovec-A
KOLKY_IMPORT_INDEX_URLS=https://vysledky.kolky.sk/
KOLKY_IMPORT_FROM=2026-07-01
KOLKY_IMPORT_TO=
KOLKY_IMPORT_QUERY=Hlohovec

# Optional local JSON fallback path when SUPABASE_SERVICE_ROLE_KEY is missing.
KKHC_DATA_DIR=.data
