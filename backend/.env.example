BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3003
# Comma-separated production origins.
# Example: https://kolkyhlohovec.com,https://www.kolkyhlohovec.com
FRONTEND_ORIGINS=

ADMIN_EMAIL=prezidentkkz@gmail.com
# REQUIRED - backend refuses to start with missing/placeholder values.
# Generate: python scripts/make-admin-hash.py (prints salt + hash for your password)
ADMIN_PASSWORD_SALT=replace-with-a-random-salt
ADMIN_PASSWORD_HASH=replace-with-a-pbkdf2-sha256-hash
SESSION_SECRET=change-this-long-random-string
# Local dev over plain http needs false; production (https) must be true.
COOKIE_SECURE=false

# Local-dev only logins. Never enable in production.
DEMO_LOGIN_ENABLED=false

KKHC_DATA_DIR=.data

# Supabase persistence for shared live data.
# Use NEXT_PUBLIC_SUPABASE_URL from the Supabase project settings and the server-only service role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LIVE_STATE_TABLE=kkhc_live_state
SUPABASE_STORAGE_BUCKET=gallery

# Import/sync secret. Sent ONLY in the x-kkhc-import-secret header, never in the URL.
# Backend returns 503 on import endpoints until this is set.
KOLKY_IMPORT_SECRET=
KOLKY_IMPORT_FROM=2025-09-01
KOLKY_IMPORT_TO=
KOLKY_IMPORT_QUERY=Hlohovec
KOLKY_IMPORT_URLS=
KOLKY_IMPORT_INDEX_URLS=https://vysledky.kolky.sk/archive,https://vysledky.kolky.sk/
KOLKY_IMPORT_CACHE_FILE=fixtures/kolky-hlohovec-matches.json
KOLKY_IMPORT_ID_FROM=43000
KOLKY_IMPORT_ID_TO=47000

# Production example (server / docker):
# BACKEND_HOST=0.0.0.0
# FRONTEND_ORIGIN=https://kolkyhlohovec.com
# FRONTEND_ORIGINS=https://kolkyhlohovec.com,https://www.kolkyhlohovec.com
# COOKIE_SECURE=true
# KOLKY_AUTO_IMPORT_ENABLED=true
KOLKY_AUTO_IMPORT_ENABLED=false
KOLKY_AUTO_IMPORT_INTERVAL_SECONDS=86400

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
