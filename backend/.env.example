BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3003
# Comma-separated production origins.
# Example: https://kolkyhlohovec.com,https://www.kolkyhlohovec.com
FRONTEND_ORIGINS=

ADMIN_EMAIL=admin@kkhlohovec.sk
ADMIN_PASSWORD=admin123
SESSION_SECRET=change-this-long-random-string
COOKIE_SECURE=false

KKHC_DATA_DIR=.data

# Supabase persistence for shared live data.
# Use NEXT_PUBLIC_SUPABASE_URL from the Supabase project settings and the server-only service role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LIVE_STATE_TABLE=kkhc_live_state
SUPABASE_STORAGE_BUCKET=gallery

# New season sync by default. Use explicit from/to for old archives.
KOLKY_IMPORT_SECRET=
KOLKY_IMPORT_FROM=2025-09-01
KOLKY_IMPORT_TO=
KOLKY_IMPORT_QUERY=Hlohovec
KOLKY_IMPORT_URLS=
KOLKY_IMPORT_INDEX_URLS=https://vysledky.kolky.sk/archive,https://vysledky.kolky.sk/
KOLKY_IMPORT_CACHE_FILE=fixtures/kolky-hlohovec-matches.json
KOLKY_IMPORT_ID_FROM=43000
KOLKY_IMPORT_ID_TO=44050

# Production example:
# BACKEND_HOST=0.0.0.0
# FRONTEND_ORIGIN=https://kolkyhlohovec.com
# FRONTEND_ORIGINS=https://kolkyhlohovec.com,https://www.kolkyhlohovec.com
# COOKIE_SECURE=true
KOLKY_AUTO_IMPORT_ENABLED=false
KOLKY_AUTO_IMPORT_INTERVAL_SECONDS=86400

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
