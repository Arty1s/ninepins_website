{
  "name": "kkhc-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cloudflare:build": "npx -y --package=@opennextjs/cloudflare@1.20.2 opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cloudflare:deploy": "npx -y --package=wrangler@4.86.0 wrangler deploy",
    "cloudflare:preview": "npm run cloudflare:build && npx -y --package=wrangler@4.86.0 wrangler dev",
    "deploy": "npm run cloudflare:build && npm run cloudflare:deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "stripe": "^16.2.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
